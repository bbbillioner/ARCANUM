# Copy this file to .env.local and replace the placeholders.
# Never commit .env.local or paste its real values into issues, prompts, or logs.

# Public values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only. Never expose this value in browser code, logs, or Git history.
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Local: http://localhost:3000
# Production: your canonical HTTPS deployment URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
